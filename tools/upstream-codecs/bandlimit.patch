+#![allow(clippy::unwrap_used)]
+
+use bandlimit::{Rate, Stream};
+#[test]
+fn restore_preserves_complete_padded_output() {
+    for hz in [8000_i64, 16000, 22050, 24000, 32000, 44100, 48000] {
+        let from = Rate::new(hz).unwrap();
+        let to = Rate::new(16000).unwrap();
+        let input: Vec<_> = (0..hz as usize + 13)
+            .map(|i| 0.2 * (i as f32 * 0.19).sin())
+            .collect();
+        for split in [511, 1533, 2048] {
+            let mut original = Stream::new(from, to).unwrap();
+            let mut prefix = Vec::with_capacity(input.len() * 3 + 5000);
+            original.write(&input[..split], &mut prefix).unwrap();
+            let state = original.checkpoint().unwrap();
+            let mut restored = Stream::restore_checkpoint(&state).unwrap();
+            assert!(restored.checkpoint_position_matches(
+                from,
+                to,
+                split as u64,
+                prefix.len() as u64
+            ));
+            let mut a = prefix.clone();
+            let mut b = prefix;
+            a.reserve(input.len() * 3 + 5000);
+            b.reserve(input.len() * 3 + 5000);
+            for block in input[split..].chunks(511) {
+                original.write(block, &mut a).unwrap();
+                restored.write(block, &mut b).unwrap();
+            }
+            let quantum = bandlimit::Ratio::reduce(from, to).numerator() as usize;
+            let padded = input.len().div_ceil(quantum) * quantum;
+            let zeros = vec![0.0; padded - input.len()];
+            original.write(&zeros, &mut a).unwrap();
+            restored.write(&zeros, &mut b).unwrap();
+            a.extend(original.finish().unwrap());
+            b.extend(restored.finish().unwrap());
+            assert!(original.finish().unwrap().is_empty());
+            assert!(restored.finish().unwrap().is_empty());
+            assert_eq!(a.len(), padded * 16000 / hz as usize);
+            let target = (input.len() * 16000).div_ceil(hz as usize);
+            a.truncate(target);
+            b.truncate(target);
+            assert_eq!(
+                a.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                b.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                "{hz}/{split}"
+            );
+            for n in [0, 7, state.len() - 1] {
+                assert!(Stream::restore_checkpoint(&state[..n]).is_err());
+            }
+            let mut bad = state.clone();
+            bad[0] ^= 1;
+            assert!(Stream::restore_checkpoint(&bad).is_err());
+            let mut bad = state;
+            bad.push(0);
+            assert!(Stream::restore_checkpoint(&bad).is_err());
+        }
+    }
+}
