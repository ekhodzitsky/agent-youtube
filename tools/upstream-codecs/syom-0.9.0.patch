+#![allow(clippy::unwrap_used)]
+
+use std::io::{self, Cursor};
+
+#[test]
+fn checkpoints_preserve_pns_pcm_at_seven_rates_and_reject_corruption() {
+    for rate in [8000_u32, 16000, 22050, 24000, 32000, 44100, 48000] {
+        let pcm: Vec<_> = (0..rate + 1)
+            .map(|i| i.wrapping_mul(1664525).wrapping_add(1013904223) as i32 as f32 * 1e-10)
+            .collect();
+        let right: Vec<_> = pcm.iter().map(|x| -x * 0.25).collect();
+        let bytes = syom::encode_with(
+            &[&pcm, &right],
+            rate,
+            &syom::EncodeOptions::m4a()
+                .with_bitrate_bps(64000)
+                .with_pns(true)
+                .with_lookahead(true)
+                .with_short_group(true),
+        )
+        .unwrap();
+        let opts = syom::DecodeOptions::speech();
+        let mut full = syom::M4aSeek::open(Cursor::new(&bytes), opts.clone()).unwrap();
+        let mut expected = Vec::new();
+        full.decode(|frame| {
+            expected.extend(frame.planar[0].iter().map(|x| x.to_bits()));
+            Ok(())
+        })
+        .unwrap();
+        let mut first = syom::M4aSeek::open(Cursor::new(&bytes), opts.clone()).unwrap();
+        let mut got = Vec::new();
+        let mut frames = 0;
+        assert!(
+            first
+                .decode(|frame| {
+                    got.extend(frame.planar[0].iter().map(|x| x.to_bits()));
+                    frames += 1;
+                    if frames == 3 {
+                        return Err(syom::AacError::Io(io::Error::other("pause")));
+                    }
+                    Ok(())
+                })
+                .is_err()
+        );
+        let state = first.checkpoint().unwrap();
+        let mut resumed = syom::M4aSeek::open(Cursor::new(&bytes), opts.clone()).unwrap();
+        resumed.restore_checkpoint(&state).unwrap();
+        resumed
+            .decode(|frame| {
+                got.extend(frame.planar[0].iter().map(|x| x.to_bits()));
+                Ok(())
+            })
+            .unwrap();
+        assert!(resumed.presentation_complete());
+        assert_eq!(got, expected, "rate {rate}");
+        for length in [0, 7, 40, state.len() - 1] {
+            assert!(resumed.restore_checkpoint(&state[..length]).is_err());
+        }
+        let mut bad = state.clone();
+        bad[0] ^= 1;
+        assert!(resumed.restore_checkpoint(&bad).is_err());
+        let mut bad = state;
+        bad[45..49].copy_from_slice(&f32::NAN.to_bits().to_le_bytes());
+        assert!(resumed.restore_checkpoint(&bad).is_err());
+    }
+}
