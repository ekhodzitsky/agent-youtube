+#[test]
+fn indexed_presentation_accepts_only_sub_millisecond_rounding() {
+    let mut bytes = syom::encode_with(&[&[0.1f32]], 48000, &syom::EncodeOptions::m4a()).unwrap();
+    let edit = bytes.windows(4).position(|w| w == b"elst").unwrap();
+    bytes[edit + 12..edit + 16].copy_from_slice(&48000_u32.to_be_bytes());
+    let mut decoder =
+        syom::M4aSeek::open(Cursor::new(&bytes), syom::DecodeOptions::speech()).unwrap();
+    decoder.decode(|_| Ok(())).unwrap();
+    let actual = decoder.position();
+    assert!(!decoder.presentation_complete());
+    let movie = bytes.windows(4).position(|w| w == b"mvhd").unwrap();
+    bytes[movie + 16..movie + 20].copy_from_slice(&1000_u32.to_be_bytes());
+    for (extra, valid) in [(0, true), (1, false), (1000, false)] {
+        let ticks = u32::try_from(actual.div_ceil(48)).unwrap() + extra;
+        bytes[edit + 12..edit + 16].copy_from_slice(&ticks.to_be_bytes());
+        let mut seek =
+            syom::M4aSeek::open(Cursor::new(&bytes), syom::DecodeOptions::speech()).unwrap();
+        seek.decode(|_| Ok(())).unwrap();
+        assert_eq!(seek.presentation_complete(), valid);
+        let mut emitted = 0;
+        let result = syom::decode_seek_streaming(
+            Cursor::new(&bytes),
+            &syom::DecodeOptions::speech(),
+            |frame| {
+                emitted += frame.planar[0].len();
+                Ok(())
+            },
+        );
+        assert_eq!(result.is_ok(), valid);
+        if valid {
+            assert_eq!(emitted as u64, actual);
+        }
+    }
